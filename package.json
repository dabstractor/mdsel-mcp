{
  "name": "mdsel-mcp",
  "version": "1.0.0",
  "description": "MCP server for mdsel CLI - declarative Markdown selection",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "mdsel-mcp": "./dist/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "markdown",
    "mdsel"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "mdsel": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "mdsel": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
